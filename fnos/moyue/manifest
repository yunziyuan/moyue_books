# ============================================
# 墨阅（个人图书管理系统） - 飞牛 fnOS 应用清单
# ============================================
# 应用唯一标识：与 fpk 目录名一致，安装后不可修改
appname               = moyue
# 版本号（三段式）：升级时递增，须大于已安装版本
version               = 1.0.4
# 应用中心显示的名称
display_name          = 墨阅书屋
# 应用描述（支持 HTML 富文本）
desc                  = <b>墨阅书屋</b>：部署在飞牛上的个人书库与阅读中心——管书、看书、听书一站搞定。<br/><br/>● 多格式书库：拖拽批量导入 EPUB、MOBI、AZW3、PDF、MD、TXT 等格式，自动识别书名、作者、出版社；书架搜索、收藏夹、阅读统计一目了然<br/>● 沉浸阅读：目录导航、翻页、字体字号与主题随心设置，划线高亮、批注笔记，阅读进度自动保存，随时接着看<br/>● AI 听书：一键将电子书分段合成有声书，自动跳过目录、断点续传，支持暂停/恢复与试听；生成后全局后台播放，锁屏也能用系统面板控制<br/>● 感想留痕：内置读后感阅读视图，记录心得、查看字数与阅读时长<br/>● 轻松分享：图书与有声书一键生成链接，手机、平板随时访问<br/>所有数据仅保存在你的飞牛本机，书籍文件可在「文件管理」中直接查看。
# 目标架构：x86 / arm / all（须与编译的二进制架构一致）
platform              = arm
# 应用来源：第三方应用固定为 thirdparty
source                = thirdparty
# 开发者信息
maintainer            = xiao
distributor           = xiao
# 应用标签（英文逗号分隔），用于应用中心分类展示
labels                = 图书,阅读,管理,工具,有声书
# 应用包大小（MB，估算值，可按实际 .fpk 大小修正）
size                  = 15
# 服务端口：应用监听 TCP 端口（系统自动注入 TRIM_SERVICE_PORT，用户在应用设置中可改），
# 供外部直接访问——书籍分享链接、局域网直连等场景不再依赖统一网关
service_port          = 18080
# 端口可由用户在应用设置中自定义（经 cmd/config_callback 写入 port.conf 并重启），
# 故关闭系统端口探测，避免 fnOS 因端口变化判定应用异常
checkport             = false
# 由 cmd/main 负责停止/启动，保证端口变更后能通过标准脚本平滑重启
ctl_stop              = true
# 统一网关模式：同时监听 Unix Socket（见 ui/config gatewaySocket）由飞牛网关反代，双入口互不冲突
# 桌面 UI 目录（app/ui -> target/ui）与启动入口（对应 ui/config 中的 .url 键）
desktop_uidir         = ui
desktop_applaunchname = moyue.Application
# 更新日志（升级时同步更新，应用中心展示）
changelog             = 1.0.4: 1. 优化移动端显示及分页获取。2. 新增安卓端apk应用 3.新增书架使用习惯
